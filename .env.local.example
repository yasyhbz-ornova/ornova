NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server-only AI connection. Never prefix these values with NEXT_PUBLIC_.
ORNOVA_AI_ENABLED=false
ORNOVA_AI_BASE_URL=http://127.0.0.1:20128/v1
ORNOVA_AI_API_KEY=
ORNOVA_AI_TEXT_MODEL=
ORNOVA_AI_IMAGE_MODEL=
# Comma-separated Supabase IDs allowed to test; trusted staff can also test.
ORNOVA_AI_PREVIEW_USER_IDS=
# Server-only writer for private generated designs. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only namespace of the verified PCS source; leave empty until identified.
# This is not an API credential and does not enable an online calculator.
ORNOVA_PCS_SOURCE_KEY=
# Private native pricing connector — server-only; keep disabled until reviewed.
# Default transport is literal loopback HTTP. HTTPS requires the exact approved
# canonical origin in ORNOVA_PRICING_ALLOWED_ORIGIN (no trailing slash).
ORNOVA_PRICING_ENABLED=false
ORNOVA_PRICING_TRANSPORT=loopback
ORNOVA_PRICING_URL=
ORNOVA_PRICING_ALLOWED_ORIGIN=
ORNOVA_PRICING_TOKEN=
